# Ziel-Hardware definieren
CONFIG_TYPE_7490=y

# Firmware-Basis auf das aktuelle FRITZ!OS festlegen
CONFIG_FIRMWARE_762=y

# Kernel-Module für das IPv6-NAT & Versteck-Modus (Mangle) aktivieren
CONFIG_MODULE_ip6table_nat=y
CONFIG_MODULE_ip6t_MASQUERADE=y
CONFIG_MODULE_ip6table_mangle=y
CONFIG_MODULE_ip6t_HL=y
CONFIG_MODULE_nf_conntrack_ipv6=y

# Freetz-Grundsystem im Image aktivieren
CONFIG_PACKAGE_MOD_CGI=y
